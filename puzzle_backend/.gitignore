# --- Environments ---
venv/
env/
*.pyc
__pycache__/
.env # CRITICAL: Ignore file with secrets (DB password, Azure keys, SECRET_KEY)

# --- Django ---
*.log
db.sqlite3 # Ignore default SQLite database if not used
db.sqlite3-journal
/staticfiles/ # Ignore collected static files (run collectstatic on deploy)
/media/ # Ignore user-uploaded media files

# --- Operating System Files ---
.DS_Store # macOS
Thumbs.db # Windows
ehthumbs.db # Windows

# --- IDEs / Editors ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw? # Vim swap files

# --- Python ---
*.egg-info/
dist/
build/
*.egg

# --- Other ---
# Add any other specific files or directories you want to ignore
# e.g., local_settings.py if you use it